#!/usr/bin/env bash
set -e

# Prepare a receptor and a ligand-centered or ligand-free site. Third-party
# diagnostics are retained in logs; modified residues, protonation, and inferred
# templates still require scientific inspection after successful preparation.

###############################################################################
# Version
# v1.35.3_interactive_feedback integrates the Copilot surgical fixes into v1.33 and adds guided parameter/centroid advice:
#   - recompute ligand centroid inside the alpha-sphere merge block
#   - filter distant/phantom alpha spheres relative to ligand centroid
#   - tighten ligand/alpha-sphere VDW overlap criterion
#   - hide all PyMOL objects before rendering each scene to avoid ghost pockets
#   - add timestamped logging and a run log
###############################################################################
PACKAGE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PACKAGE_VERSION=$(sed -n '1p' "$PACKAGE_ROOT/VERSION" 2>/dev/null || printf 'unknown')
PYTHON_COMMAND="${DOCKING_UNIVERSAL_PYTHON:-python3}"
SCRIPT_VERSION="1.35.13_surface_local_pockets_patch1"

print_help() {
  cat <<'EOF'
Docking Universal - auditable receptor and docking-box preparation

Usage:
  docking-universal prepare-receptor <complex.pdb>
  docking-universal prepare-receptor --help

Docking Universal prepares a receptor, detects bound ligands, discovers pockets with
fpocket, and writes AutoDock Vina configuration plus PyMOL review files.
The main workflow is guided interactively.

Required tools:
  fpocket, awk, grep, sort, tee, PDBFixer, and one receptor backend:
  mk_prepare_receptor.py (Meeko) or prepare_receptor (ADFRsuite)

Optional tool:
  pymol (to open generated .pml scenes)

Common environment settings:
  BOX_SIZE=26.0                 Docking-box edge length in angstroms
  SCORE_THRESHOLD=0.10          Minimum fpocket eligibility score
  MAX_OVERLAP_FRAC=0.60         Maximum accepted box-volume overlap
  FEEDBACK_LEVEL=guided         concise, guided, or verbose
  STRICT_LOCAL_POCKETS=1        Reject unusually broad pockets
  SHOW_POCKET_SURFACE=1         Render pocket surfaces in PyMOL scenes
  DOCKING_UNIVERSAL_FPOCKET     fpocket executable path
  DOCKING_UNIVERSAL_PREP_BACKEND   auto, meeko, or adfr
  DOCKING_UNIVERSAL_PREP_RECEPTOR  receptor backend executable path
  DOCKING_UNIVERSAL_LOG_MODE       tee (default) or file (restricted/headless)
  DOCKING_UNIVERSAL_SITE_MODE      ask (default), ligand, or pockets
  DOCKING_UNIVERSAL_LIGAND_RESNAME Bound ligand residue name for ligand mode
  DOCKING_UNIVERSAL_CAVITY_MODE    1, 2, or 3 for unattended cavity mode
  DOCKING_UNIVERSAL_MAX_POCKETS    number of ligand-free cavities to retain
  DOCKING_UNIVERSAL_CENTER_MODE    deepest or centroid for ligand-free review
  DOCKING_UNIVERSAL_CENTROID_MODE  1 whole protein or 2 per-chain centroid
  DOCKING_UNIVERSAL_PDBFIXER=auto  auto, required, or off
  DOCKING_UNIVERSAL_ADFR_FALLBACK=1 Try legacy ADFRsuite only after Meeko rejects linked chemistry
  MEEKO_ALLOW_BAD_RES=0         Set 1 to delete unmatched residues (review output)
  MEEKO_DEFAULT_ALTLOC          Optional default alternate location, e.g. A
  MEEKO_SET_TEMPLATE            Explicit residue template, e.g. A:36=HIE

Example:
  FEEDBACK_LEVEL=guided docking-universal prepare-receptor receptor_complex.pdb

See the project README for the complete settings reference and scientific
method notes.
EOF
}

print_version() {
  printf 'Docking Universal %s (workflow %s)\n' "$PACKAGE_VERSION" "$SCRIPT_VERSION"
}

doctor() {
  missing=0
  for tool in fpocket awk grep sort tee; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf 'ok       %s\n' "$tool"
    else
      printf 'missing  %s\n' "$tool"
      missing=1
    fi
  done

  if "$PYTHON_COMMAND" -c 'import pdbfixer, openmm' >/dev/null 2>&1; then
    printf 'ok       PDBFixer receptor pre-cleaning\n'
  else
    printf 'missing  PDBFixer receptor pre-cleaning\n'
    missing=1
  fi

  if command -v mk_prepare_receptor.py >/dev/null 2>&1; then
    printf 'ok       mk_prepare_receptor.py (Meeko backend)\n'
  elif command -v prepare_receptor >/dev/null 2>&1; then
    printf 'ok       prepare_receptor (ADFRsuite backend)\n'
  else
    printf 'missing  receptor preparation backend (Meeko or ADFRsuite)\n'
    missing=1
  fi

  if command -v pymol >/dev/null 2>&1; then
    printf 'ok       pymol (optional)\n'
  else
    printf 'optional pymol (generated scenes can be opened elsewhere)\n'
  fi

  if [ "$missing" -ne 0 ]; then
    printf '\nInstall the missing required tools before running Docking Universal.\n' >&2
    return 1
  fi

  printf '\nDocking Universal is ready.\n'
}

case "${1:-}" in
  -h|--help)
    print_help
    exit 0
    ;;
  -V|--version)
    print_version
    exit 0
    ;;
  doctor)
    doctor
    exit $?
    ;;
esac

SUPPORT_LIBRARY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/docking-universal-prepare-support.sh"
[ -r "$SUPPORT_LIBRARY" ] || { echo "ERROR: receptor preparation support library is missing: $SUPPORT_LIBRARY" >&2; exit 2; }
. "$SUPPORT_LIBRARY"

###############################################################################
# INPUT VALIDATION
###############################################################################
[ "$#" -eq 1 ] || { print_help >&2; exit 2; }
INPUT_PDB="$1"
[ -f "$INPUT_PDB" ] || { echo "ERROR: input PDB not found: $INPUT_PDB" >&2; exit 2; }
REGION_CHECK="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/docking-universal-region-check.py"
[ -f "$REGION_CHECK" ] || { echo "ERROR: receptor input-validation helper is missing: $REGION_CHECK" >&2; exit 2; }
"$PYTHON_COMMAND" "$REGION_CHECK" --validate-protein-pdb "$INPUT_PDB"

###############################################################################
# USER DEFAULTS
###############################################################################
load_prepare_runtime_defaults || exit $?

###############################################################################
# REQUIREMENTS
###############################################################################
resolve_prepare_runtime_tools || exit $?

###############################################################################
# INPUT
###############################################################################
initialize_prepare_run_layout || exit $?
log "Starting receptor/cavity preparation pipeline ($SCRIPT_VERSION)"
log "Input PDB: $INPUT_PDB"
log "Output root: $ROOT"
log "Receptor preparation backend: $PREP_BACKEND ($PREP_RECEPTOR_BIN)"
choose_feedback_level
log "Feedback level: $FEEDBACK_LEVEL"
print_settings_summary
feedback_verbose && print_parameter_guidance

###############################################################################
###############################################################################
# STEP 1: RECEPTOR PREP
###############################################################################
initialize_receptor_preparation || exit $?

run_safe_receptor_preparation_attempts

handle_receptor_failure_and_removal_approval

finalize_receptor_preparation_audit || exit $?

###############################################################################
# LIGAND DETECTION (RESTORED WORKING LOGIC)
###############################################################################
echo
log "=== STEP 1b: Detecting ligand ==="

resolve_site_ligand_strategy || exit 1
###############################################################################
# STEP 2: FPOCKET
###############################################################################
resolve_pocket_search_policy || exit $?

execute_fpocket_strategy
normalize_fpocket_outputs
###############################################################################
# STEP 3: FILTER POCKETS BY SCORE + WRITE DIAGNOSTICS
###############################################################################
classify_and_select_fpocket_sites

###############################################################################
# STEP 5: BUILD OUTPUTS
###############################################################################
materialize_selected_site_artifacts

###############################################################################
# STEP 6: README
###############################################################################
write_preparation_summary "$CAVITY_DIR/${CANONICAL}_README.txt"


report_preparation_completion
