#!/usr/bin/env bash
set -eu

# ADFRsuite and similar legacy tools may export these globally, which can make
# a Conda Python load another interpreter's standard library. Each scientific
# subprocess resolves its own packages, so inherited Python paths are unsafe.
unset PYTHONHOME PYTHONPATH

# Installed beside the user's Conda executable by install.sh. This keeps every
# public subcommand available without requiring an activated environment.
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
conda_command=${DOCKING_UNIVERSAL_CONDA:-"$launcher_dir/conda"}

if [ ! -x "$conda_command" ]; then
  conda_command=conda
fi

if ! command -v "$conda_command" >/dev/null 2>&1; then
  printf 'Error: Conda was not found. Reinstall Docking Universal with bash install.sh.\n' >&2
  exit 1
fi

# The modern desktop and PyMOL deliberately use different Qt generations.
# Resolve PyMOL in its companion environment and pass the executable to the
# PyQt6 desktop instead of exposing either environment to the user's shell.
if [ "${1:-}" = "desktop" ]; then
  gui_environment=${DOCKING_UNIVERSAL_GUI_ENV:-docking-universal-gui-next}
  pymol_environment=${DOCKING_UNIVERSAL_PYMOL_ENV:-docking-universal-pymol-next}
  scientific_environment=${DOCKING_UNIVERSAL_ENV:-docking-universal}
  gui_prefix=$("$conda_command" run -n "$gui_environment" printenv CONDA_PREFIX) || {
    printf 'Error: GUI environment is unavailable: %s\n' "$gui_environment" >&2
    exit 1
  }
  pymol_prefix=$("$conda_command" run -n "$pymol_environment" printenv CONDA_PREFIX) || {
    printf 'Error: PyMOL companion environment is unavailable: %s\n' "$pymol_environment" >&2
    exit 1
  }
  scientific_prefix=$("$conda_command" run -n "$scientific_environment" printenv CONDA_PREFIX) || {
    printf 'Error: scientific environment is unavailable: %s\n' "$scientific_environment" >&2
    exit 1
  }
  gui_python="$gui_prefix/bin/python"
  pymol_command="$pymol_prefix/bin/pymol"
  host_python="$scientific_prefix/bin/python"
  desktop_script="$scientific_prefix/libexec/docking-universal/docking-universal-desktop.py"
  if [ ! -x "$gui_python" ]; then gui_python="$gui_prefix/python.exe"; fi
  if [ ! -x "$pymol_command" ]; then pymol_command="$pymol_prefix/Scripts/pymol.exe"; fi
  if [ ! -x "$host_python" ]; then host_python="$scientific_prefix/python.exe"; fi
  [ -x "$gui_python" ] || { printf 'Error: Python was not found in %s\n' "$gui_environment" >&2; exit 1; }
  [ -x "$pymol_command" ] || { printf 'Error: PyMOL was not found in %s\n' "$pymol_environment" >&2; exit 1; }
  [ -x "$host_python" ] || { printf 'Error: Python was not found in %s\n' "$scientific_environment" >&2; exit 1; }
  [ -f "$desktop_script" ] || { printf 'Error: Docking Universal desktop is not installed in %s\n' "$scientific_environment" >&2; exit 1; }
  shift
  exec "$conda_command" run --no-capture-output -n "$gui_environment" \
    "$gui_python" "$desktop_script" --pymol "$pymol_command" \
    --host-python "$host_python" "$@"
fi

# `conda run` manages its descendant process group.  If the in-environment
# validator starts its own background child and immediately returns, Conda can
# terminate that child while cleaning up the completed run.  For the public
# no-activation launcher, keep `conda run` itself alive as the detached process
# and run validation in the foreground inside it.
if [ "${1:-}" = "validate" ]; then
  background=0
  for argument in "$@"; do
    [ "$argument" != "--background" ] || background=1
  done
  if [ "$background" -eq 1 ]; then
    shift
    level="${1:-}"
    case "$level" in
      smoke|quick|integration|release) shift ;;
      *) printf 'Error: validation level must be smoke, quick, integration, or release.\n' >&2; exit 2 ;;
    esac
    output=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --out) output="${2:-}"; [ -n "$output" ] || { printf 'Error: --out requires a directory.\n' >&2; exit 2; }; shift 2 ;;
        --background) shift ;;
        *) printf 'Error: unknown background-validation option: %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    timestamp=$(date '+%Y%m%d_%H%M%S')
    [ -n "$output" ] || output="$PWD/validation_runs/${level}_${timestamp}"
    case "$output" in /*) ;; *) output="$PWD/$output" ;; esac
    [ ! -e "$output" ] || { printf 'Error: validation output already exists: %s\n' "$output" >&2; exit 2; }
    mkdir -p "$output"
    : > "$output/pid"
    nohup "$conda_command" run --no-capture-output -n docking-universal \
      docking-universal validate "$level" --out "$output" \
      > "$output/run.log" 2>&1 < /dev/null &
    pid=$!
    printf '%s\n' "$pid" > "$output/pid"
    printf '{"status":"RUNNING","level":"%s","pid":%s,"output":"%s"}\n' \
      "$level" "$pid" "$output" > "$output/status.json"
    printf 'Validation started in the background.\nLevel: %s\nPID: %s\nOutput: %s\n' \
      "$level" "$pid" "$output"
    printf 'Progress: tail -f "%s/run.log"\nStatus: cat "%s/status.json"\n' "$output" "$output"
    exit 0
  fi
fi

exec "$conda_command" run --no-capture-output -n docking-universal \
  docking-universal "$@"
